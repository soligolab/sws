[Unit]
Description=SWS SCADA runtime
Documentation=https://github.com/soligolab/sws
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/sws/bin/sws-runtime-launch.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Not root (18-11-2026, decision D19 of the CRA sessions): the installer
# creates the system user `sws`, hands it /var/lib/sws, and installs the polkit
# rule that lets the control panel change network, time, reboot and power-off.
User=sws
Group=sws
# Serial ports for Modbus RTU (/dev/ttyUSB*, /dev/ttyS*): root had them, `sws`
# gets them through the group, as on the Tiny TY.
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
