# Quadlet unit per il runtime SWS in container podman (rootless).
#
# Installato da `install-container.sh` in
#   ~/.config/containers/systemd/sws-runtime.container
# da cui systemd genera automaticamente `sws-runtime.service`. Con podman >= 4.4
# è il modo supportato per far gestire un container da systemd: non serve
# `podman generate systemd`, e l'unit non va rigenerata quando cambia l'immagine.
#
# Perché serve: un container rootless NON riparte dopo un reboot nemmeno con
# `--restart=unless-stopped` — quel flag vale solo finché il servizio utente di
# podman è vivo. Serve `loginctl enable-linger` più un'unit utente, ed è quello
# che l'installer configura.
#
# Comandi (come utente, senza sudo):
#   systemctl --user status  sws-runtime
#   systemctl --user restart sws-runtime
#   journalctl --user -u sws-runtime -f

[Unit]
Description=SWS runtime (container podman)
Documentation=file:///data/user/sws-container/README
After=network-online.target
Wants=network-online.target

[Container]
# Riferimento pubblico sul registry: chi copia questa unit a mano ottiene
# l'immagine giusta senza doverla costruire. `install-container.sh` riscrive
# comunque questa riga con ciò che ha effettivamente installato (--pull, --image
# o --tag), quindi qui conta solo come default sensato.
Image=ghcr.io/soligolab/sws-runtime:latest-arm64
ContainerName=sws-runtime

# ── Riaccendere l'IDE su questo dispositivo ─────────────────────────────────
#
# Dalla 2.4.0 l'immagine parte con `--no-admin`: sulla 8444 c'è solo la gestione
# remota che l'editor chiama (deploy, pull, backup, utenti, datastore), e
# **nessuna interfaccia**. L'IDE sul dispositivo è un caso particolare — messa in
# servizio, assistenza — non il default.
#
# Per riaccenderlo: togliere il `#` dalla riga `Exec=` qui sotto (che è il CMD
# dell'immagine **senza** `--no-admin`), poi
#
#     systemctl --user daemon-reload && systemctl --user restart sws-runtime
#
# La riga sta qui già scritta di proposito: `Exec=` sovrascrive il CMD per
# intero, quindi ricostruirla a memoria vuol dire sbagliarne un pezzo e ritrovarsi
# un container che non parte — o che parte senza `--www` e serve una pagina bianca.
# Ricomporla non è un lavoro da fare su un dispositivo in campo.
#
#Exec=--config /var/sws/config --projects-root /var/sws/projects --templates-root /var/sws/templates --www /var/sws/www --viewer-port 8443 --admin-port 8444

# 8443 viewer operatori, 8444 IDE/admin. Porte > 1024: rootless le binda
# senza privilegi.
#
# ATTENZIONE: queste due righe valgono solo in modalità bridge, che NON è più
# il default. `install-container.sh` senza flag le commenta e mette
# Network=host, perché sulla rete rootless di podman il multicast mDNS non esce
# dal container e "Cerca runtime" nell'IDE non trova mai il dispositivo. Restano
# qui, e non sostituite da Network=host, perché è l'installer a scegliere: con
# `--bridge` il file viene copiato così com'è.
PublishPort=8443:8443
PublishPort=8444:8444

# Bind mount su un percorso esplicito dell'host invece di volumi nominati:
# i dati (progetti, config, historian) restano visibili e copiabili in
# /data/user/sws senza passare da `podman volume inspect`, e la partizione
# /data è quella scrivibile sui device Pixsys — stessa collocazione del
# percorso di installazione nativo.
#
# Funziona sotto rootless perché il container gira come root e in rootless
# l'UID 0 del container è mappato sull'utente dell'host: i file creati
# risultano di `user`, che è il proprietario di /data/user/sws. (Con podman
# rootful il mapping sarebbe diverso e i permessi andrebbero rivisti.)
#
# Qui stanno solo i DATI. La SPA non è più fra questi: dal 2026-07-30 è dentro
# l'immagine, e montarci sopra una directory dell'host la nasconderebbe (con
# l'effetto di una interfaccia vuota e nessun indizio del perché).
Volume=/data/user/sws/config:/var/sws/config
Volume=/data/user/sws/projects:/var/sws/projects
Volume=/data/user/sws/logs:/var/sws/logs

# Il bus di sistema, in sola lettura sul socket: serve al runtime per dire al
# launcher Pixsys quale immagine di accensione usare
# (`net.pixsys.Config1.Launcher.SetBackgroundImage`), dal **container**.
#
# Prima quella chiamata la faceva uno script sull'host, svegliato da una
# `.path` unit che guardava un file `trigger`: tre pezzi installati sul
# dispositivo, che esistevano solo perché un container non parla col bus.
# Vincolo del maintainer del 24-09-2026: «nell'host non puoi toccare nulla,
# tutto deve essere fatto con chiamate dBus dal container».
#
# **Cosa apre**: il socket dà accesso a *tutto* il bus di sistema, non al solo
# launcher — sul dispositivo è già `srw-rw-rw-`, quindi non concede niente che
# un processo dell'utente non avesse, ma il container smette di essere isolato
# da quel lato. Se un giorno serve stringere, la strada è un proxy che inoltri
# la sola interfaccia del launcher.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro

# Dove sta, **vista dall'host**, la cartella che il container conosce come
# `/var/sws/config`. Senza, il runtime direbbe al launcher un percorso che
# sull'host non esiste: da dentro il container la mappatura non si deduce, e
# un percorso sbagliato è peggio di nessuna chiamata (il launcher accetta e
# poi non trova il file). Deve restare uguale al `Volume=` qui sopra.
#
# Sta in `[Container]` e non in `[Service]`: nella seconda finirebbe
# nell'ambiente dell'unit systemd e **non** in quello del processo dentro il
# container — provato sul WP630 il 24-09-2026, `printenv` nel container non la
# vedeva e la chiamata al launcher non partiva, in silenzio.
Environment=SWS_HOST_CONFIG_DIR=/data/user/sws/config

# L'uid dentro il container deve essere lo stesso di fuori, o il bus di
# sistema rifiuta la connessione.
#
# D-Bus autentica con EXTERNAL: il client **dichiara** il proprio uid e il
# kernel ne riporta un altro al server, che confronta i due. In un container
# rootless senza questa riga il processo è `root` (uid 0) dentro e uid 1000
# fuori, i due numeri non coincidono e il bus risponde:
#
#   D-Bus handshake failed: EXTERNAL rejected by the server
#
# Misurato sul WP630 il 24-09-2026. Con `keep-id` l'uid interno è quello
# dell'utente che lancia il container e i due coincidono: il launcher accetta.
# I file sui volumi restano di quell'utente, come prima — cambia il numero
# dentro il container, non il proprietario sul disco.
UserNS=keep-id

# ── Aggiornamento del runtime (27-09-2026) ──────────────────────────────────
#
# Piano docs/plans/2026-09-27-aggiornamento-runtime-e-bus-utente.md.
#
# `AutoUpdate=registry`: `podman auto-update` confronta l'immagine dietro il
# tag di `Image=` con quella del registry e, se è cambiata, la scarica e
# riavvia il servizio. Il tag è il **canale**: `latest-<arch>` (stabile) o
# `rc-<arch>` (prova). Non parte da solo: il timer di podman resta spento, e
# lo avvia il runtime quando un Admin lo chiede (o nella finestra scelta).
# L'installer la commenta per un'immagine da archivio (`localhost/…`), che
# non ha un registry da seguire.
AutoUpdate=registry

# `Notify=healthy`: il servizio risulta avviato solo quando l'HEALTHCHECK
# passa. È ciò che rende sicuro l'aggiornamento: se la versione nuova non
# diventa *healthy*, il riavvio fallisce e `podman auto-update` torna da solo
# alla precedente. Esiste da podman 5: l'installer la toglie sui 4.x, che la
# rifiuterebbero rendendo invalida l'intera unit.
Notify=healthy

# Il bus **utente** di systemd, per avviare `podman-auto-update.service` da
# dentro il container (un container non può riavviare se stesso). Provato sul
# TC620 il 27-09-2026: con `UserNS=keep-id` l'autenticazione passa, senza viene
# rifiutata. Dà al runtime il comando delle unit dell'utente, non solo delle
# nostre: scelta del maintainer, preferita al socket di podman, che darebbe il
# controllo di tutti i container. L'installer adatta `1000` all'uid vero.
Volume=/run/user/1000/bus:/run/user/1000/bus
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Il fuso del pannello, per la finestra dell'aggiornamento (Fase 2, 28-09-2026):
# «domenica alle 3» sono le 3 del pannello, cambio d'ora compreso. Senza, il
# container è in UTC anche su un pannello in ora italiana (misurato sul TC620).
# Podman copia il fuso dell'host nel container: non si monta né si tocca niente.
Timezone=local

# Quale immagine sta girando: da dentro il container non si sa
# (`/run/.containerenv` è vuoto in un container rootless). La riscrive
# l'installer uguale a `Image=`; il runtime ne ricava il canale e se è
# un'installazione da archivio.
Environment=SWS_IMAGE=ghcr.io/soligolab/sws-runtime:latest-arm64

[Service]
Restart=always
RestartSec=5
# Il runtime gestisce SIGTERM e chiude in ~1 s; 30 s è margine abbondante e
# serve a non farlo mai finire in SIGKILL a metà di una scrittura su
# project.yaml o sull'SQLite dell'historian.
TimeoutStopSec=30

[Install]
# `default.target` (sessione utente) e non `desktop.target`: il runtime deve
# girare **anche** mentre il pannello è in modalità configurazione Pixsys — la
# schermata che si apre tenendo premuto STOP all'avvio. Impianto, storico e
# allarmi non si fermano perché qualcuno sta sistemando la rete.
#
# È deliberato, non una svista rispetto alla commutazione dello schermo, che invece si
# astiene dal toccare lo schermo in quella modalità: la configurazione riguarda
# il *dispositivo*, non l'*applicazione*.
WantedBy=default.target
