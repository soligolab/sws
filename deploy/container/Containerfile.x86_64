# SWS runtime — immagine container x86_64 (amd64), stesso installer e stessa
# esperienza del percorso aarch64 (Containerfile.aarch64), su una macchina di
# sviluppo/device x86_64 qualunque.
#
# NON compila nulla: il binario arriva già compilato da
# `scripts/build_container_x86_64.sh`, che lo produce dentro l'immagine
# `Containerfile.x86_64.builder`. Nessun cross-compile — l'architettura di build
# e quella target coincidono — ma nemmeno una compilazione sull'host, che
# legherebbe l'immagine alla macchina che la costruisce (vedi il commento sul
# `FROM` qui sotto).
#
# Il contesto di build è la directory staging preparata da quello script
# (bin/, templates/, www/), non la radice del repo: tenerlo piccolo evita di
# impacchettare target/ e node_modules.
#
# Percorso separato e indipendente da `sws-runtime/docker/Dockerfile`
# (immagine legacy, disattivata in CI) e da `Containerfile.aarch64` (device
# Pixsys Yocto). Vedi docs/DEPLOY_CONTAINER_X86_64.md.

# `ubuntu:24.04`, la STESSA base dell'immagine aarch64.
#
# Non è una preferenza: la base la impone il binario. PyO3 gira con
# `auto-initialize`, quindi il binario linka la `libpython` dell'ambiente che lo
# compila. Prima si compilava sull'host e la riga `FROM` andava riverificata a
# mano su ogni macchina di build — una Debian 12 produce un binario che chiede
# `libpython3.11.so.1.0`, una macchina con pyenv `libpython3.13`, e l'immagine
# risultava diversa da una postazione all'altra.
#
# Ora il binario si compila dentro `Containerfile.x86_64.builder`, che è pure
# `ubuntu:24.04`: linka Python 3.12 e glibc 2.39, cioè esattamente ciò che
# questa base offre. La verifica `readelf` non è sparita, la fa
# `build_container_x86_64.sh` sul binario prodotto e si ferma se non combacia.
#
# Il risultato è che le due architetture sono gemelle: aarch64 ha l'SDK Yocto
# Pixsys a garantire un binario sempre uguale, x86_64 ha l'immagine builder.
FROM ubuntu:24.04

# python3: PyO3 gira con `auto-initialize`, quindi serve l'interprete completo
#   (stdlib inclusa), non la sola libpython.
# python3-pip + RestrictedPython: senza, il motore script parte NON sandboxato
#   con un warning all'avvio. L'immagine legacy aveva esattamente questo buco.
# curl: usato dall'HEALTHCHECK qui sotto.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        libpython3.12t64 \
        git \
        openssh-client \
        python3-pip && \
    pip install --no-cache-dir --break-system-packages "RestrictedPython>=7.0" && \
    apt-get purge -y python3-pip && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

COPY bin/sws-runtime /usr/local/bin/sws-runtime
COPY templates/      /var/sws/templates/
COPY catalogo/       /var/sws/catalogo/
# git nei progetti (15-10-2026, docs/plans/2026-10-15-git-nel-cloud.md): git e
# openssh-client sopra, e qui le chiavi ufficiali di GitHub, GitLab e Bitbucket,
# così il primo push verso di loro non deve fidarsi «al primo contatto».
# Si rigenera con scripts/known_hosts_git.sh.
COPY ssh_known_hosts  /etc/ssh/ssh_known_hosts

# La SPA sta DENTRO l'immagine, come nel percorso aarch64 e per le stesse
# ragioni (vedi il commento esteso in Containerfile.aarch64): col registry i
# layer si deduplicano, quindi un frontend nuovo trasferisce il solo layer
# della SPA e non l'immagine intera, e non esiste più il modo di ritrovarsi sul
# dispositivo una SPA di versione diversa dal binario.
#
# Sta DOPO il binario e non prima: è il layer che cambia più spesso, e un layer
# che cambia invalida tutti quelli sotto.
COPY www/            /var/sws/www/
# I quadlet e l'installer di questa versione (02-10-2026): il runtime li confronta
# con quelli installati e li sa riscrivere — docs/plans/2026-10-02-quadlet-che-viaggia.md.
COPY quadlet/        /usr/share/sws/quadlet/

# Punti di mount dei dati persistenti. Vanno montati come volumi podman:
# senza, config e progetti vivono nel layer scrivibile e spariscono col
# container. /var/sws/www NON è fra questi: è contenuto dell'immagine.
RUN mkdir -p /var/sws/config /var/sws/projects

# 7443 viewer operatori, 7444 IDE/admin.
EXPOSE 7443 7444

# L'indirizzo del gateway nel cloud (decisione 13, 11-10-2026): un pannello
# nuovo lo chiama da solo e aspetta lì, col codice di abbinamento, che qualcuno
# lo abbini dall'IDE nel cloud. Si cambia nel quadlet
# (`Environment=SWS_TUNNEL_URL=…`) e si spegne lasciandolo vuoto
# (`install-container.sh --senza-cloud`). Un IDE, il gateway e i container dei
# progetti non lo usano: non hanno un codice di abbinamento.
ENV SWS_TUNNEL_URL=wss://tunnel.soligo.net/tunnel/v1

# **Tutti e due gli schemi, e https per primo** (23-10-2026). Il runtime parte in
# HTTP finché non esiste config/tls.crt e in HTTPS appena c'è
# (sws-runtime/src/main.rs, avvio del listener): un healthcheck che ne conosce
# uno solo è rosso per sempre nell'altro caso. L'healthcheck legacy interrogava
# solo https ed era rosso su ogni pannello nuovo; questo interrogava solo http
# ed era rosso su ogni pannello su cui si fosse acceso il TLS — che è la cosa
# che il manuale consiglia di fare, e che la card «Certificato TLS» dell'IDE fa
# con un pulsante.
#
# **Non era un difetto teorico.** `Notify=healthy` nel quadlet vuol dire che il
# servizio risulta avviato solo quando questo comando passa. Accendere il TLS
# dalla UI non si vedeva subito, perché `system_reboot` è un `exec()` in posto e
# systemd non vede nessun riavvio; ma al primo riavvio vero — un reboot del
# pannello, o un aggiornamento — l'unità non sarebbe mai diventata healthy, e
# con `Restart=always`/`RestartSec=5` il pannello sarebbe ripartito ogni cinque
# secondi. Un aggiornamento, poi, sarebbe tornato indietro da solo.
#
# `-k`: il certificato è autofirmato per costruzione, e qui si sta chiedendo a
# sé stessi su localhost se si è vivi — non si sta verificando l'identità di
# nessuno.
# NB: HEALTHCHECK non esiste nella spec OCI — va costruito con
# `podman build --format docker`, altrimenti podman lo scarta con un warning.
# Terzo ripiego, la 8444 (21-10-2026): col passaggio a 7443/7444 il **gateway**
# e i container dei suoi progetti sono rimasti sulla 8444, che è interna alla
# rete del VPS (`PORTA_FIGLIO`, gateway/progetti.rs). Senza questa riga la
# stessa immagine, usata come gateway, risulterebbe «unhealthy» per sempre.
#
# Ripiego sulla 7444 (10-10-2026): un'istanza solo-IDE — il gateway nel cloud e
# i container dei suoi progetti — non ha il viewer, la 7443 non ascolta e
# risultava «unhealthy» per sempre; con `Notify=healthy` e l'aggiornamento
# automatico sarebbe stato un ritorno indietro a ogni aggiornamento. Sui
# pannelli la 7443 risponde e il ripiego non scatta mai.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsk https://localhost:7443/health || curl -fs http://localhost:7443/health \
     || curl -fsk https://localhost:7444/health || curl -fs http://localhost:7444/health \
     || curl -fsk https://localhost:8444/health || curl -fs http://localhost:8444/health \
     || exit 1

# Nessun entrypoint script: niente SWS_ADMIN_PASSWORD obbligatorio (il
# no-auth mode è lo stato normale del PoC) e i flag stanno tutti nel CMD,
# così `podman run ... <altri flag>` li può sostituire.
# --viewer-port è indispensabile: senza, il viewer non va mai in ascolto e
# l'immagine servirebbe solo l'IDE (era il difetto del Dockerfile legacy).
# Metadati OCI in fondo e non dopo il FROM: una LABEL in testa invalida la
# cache di tutto ciò che segue. Qui il layer apt è nativo e non emulato, quindi
# costa secondi e non minuti, ma la regola resta la stessa del percorso
# aarch64, dove è già costata 15 minuti di build.
# Le novità viaggiano con l'immagine (decisione 42): vedi il gemello aarch64.
# Le Novità brevi di NOVITA.yaml nelle due lingue (dal 28-09-2026). Le etichette
# vecchie `net.soligo.sws.changelog`/`.compat` restano, col testo breve in
# italiano: i runtime rc.3-rc.8 leggono solo quelle, e senza vedrebbero
# un'immagine nuova senza novità.
ARG SWS_NOVITA_IT=""
ARG SWS_NOVITA_EN=""
ARG SWS_COMPAT_IT=""
ARG SWS_COMPAT_EN=""
# La versione nostra, non quella di Ubuntu ereditata (vedi il gemello aarch64).
ARG SWS_VERSION=""
# La versione dei quadlet di questa immagine: il runtime la legge dal registry
# prima di aggiornare, per dire se dopo servirà aggiornare la configurazione.
ARG SWS_QUADLET=""
LABEL org.opencontainers.image.source="https://github.com/soligolab/sws" \
      org.opencontainers.image.version="$SWS_VERSION" \
      org.opencontainers.image.title="sws-runtime" \
      org.opencontainers.image.description="SWS runtime (x86_64) — viewer 7443, IDE/admin 7444, SPA inclusa. Montare i dati su /var/sws/{config,projects,logs}." \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      net.soligo.sws.novita.it="$SWS_NOVITA_IT" \
      net.soligo.sws.novita.en="$SWS_NOVITA_EN" \
      net.soligo.sws.compat.it="$SWS_COMPAT_IT" \
      net.soligo.sws.compat.en="$SWS_COMPAT_EN" \
      net.soligo.sws.changelog="$SWS_NOVITA_IT" \
      net.soligo.sws.compat="$SWS_COMPAT_IT" \
      net.soligo.sws.quadlet="$SWS_QUADLET"

ENTRYPOINT ["/usr/local/bin/sws-runtime"]
# ── L'IDE sul dispositivo e' un caso particolare, non il default ────────────
#
# Decisione del maintainer (2026-09-02). `--no-admin` nel CMD qui sotto **non
# toglie il Deploy**: la porta 7444 resta e serve solo la gestione remota che
# l'editor chiama (deploy, pull, backup, utenti, datastore), tutto autenticato.
# Cade l'IDE: nessuna interfaccia servita, nessuna modifica del progetto sul
# dispositivo, nessun /api/script/exec, nessun /api/fs/*. Vedi `deploy_only_app`
# in sws-web/src/router.rs e OPEN_QUESTIONS Q8.
#
# Per riaccendere l'IDE completo su un dispositivo si sovrascrive il comando nel
# quadlet (`Exec=` in sws-runtime.container) togliendo quel flag: qui non c'e' un
# entrypoint script, e non ne vogliamo uno solo per una variabile d'ambiente.
CMD ["--config", "/var/sws/config", \
     "--projects-root", "/var/sws/projects", \
     "--templates-root", "/var/sws/templates", \
     "--catalog-root", "/var/sws/catalogo/dispositivi", \
     "--www", "/var/sws/www", \
     "--viewer-port", "7443", \
     "--admin-port", "7444", \
     "--no-admin"]
