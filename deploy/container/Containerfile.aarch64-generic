# SWS runtime — immagine container aarch64 "generica", senza SDK Pixsys.
#
# Gemella di Containerfile.aarch64 (device Pixsys OS, binario cross-compilato
# con l'SDK Yocto) ma con garanzie diverse: qui il binario arriva da
# `scripts/build_container_aarch64_generic.sh`, che lo compila dentro
# `Containerfile.aarch64-generic.builder` in emulazione QEMU (build lenta,
# nessun cross-linking, nessuna toolchain speciale sull'host) — utile per
# testare senza accesso all'SDK e per device aarch64 NON Pixsys (Raspberry
# Pi, VM cloud arm64, ecc). Non pensata per sostituire il percorso SDK su un
# device Pixsys reale: niente tuning cortex-a35, niente ABI pinning esatto
# all'OS Pixsys — solo la stessa base ubuntu:24.04 del resto della famiglia
# container. Vedi docs/DEPLOY_CONTAINER_AARCH64.md, sezione "Percorso
# generico".
#
# Il contesto di build è la directory staging preparata da quello script
# (bin/, templates/, www/), non la radice del repo: tenerlo piccolo evita di
# impacchettare target/ e node_modules.

# ubuntu:24.04, la STESSA base di Containerfile.aarch64/Containerfile.x86_64.
# Il vincolo è lo stesso dei due gemelli: PyO3 con `auto-initialize` linka la
# libpython dell'ambiente che compila, e il builder (stesso ubuntu:24.04)
# garantisce che combaci per costruzione — verificato comunque con `readelf`
# alla fine dello script di build, non solo assunto.
FROM ubuntu:24.04

# Passato da scripts/build_container_aarch64_generic.sh (--build-arg
# WITH_LVGL=1 quando --with-lvgl è attivo). Serve solo per decidere se
# installare libsdl2-2.0-0 qui sotto — il builder installa già libsdl2-dev,
# ma quello vive in un'immagine intermedia separata che non arriva mai qui:
# sws-lvgl-viewer linka SDL2 dinamicamente, quindi senza la libreria runtime
# nell'immagine finale parte e crash-a subito ("cannot open shared object
# file", scoperto sul primo test reale, 2026-08-09 — non un'ipotesi). Non
# installata incondizionatamente: chi non passa --with-lvgl non deve
# appesantirsi per una dipendenza che non usa (stesso principio del builder
# separato in Containerfile.aarch64-generic-lvgl.builder).
ARG WITH_LVGL=0

# libegl1/libegl-mesa0/libgles2/libgl1-mesa-dri/libwayland-egl1/libgbm1
# (sotto lo stesso WITH_LVGL, non un flag a parte). Nate come tentativo di
# risolvere un SIGSEGV sotto SDL_VIDEODRIVER=wayland (non hanno funzionato
# lì: quel crash è un bug logico interno a SDL2, non una libreria mancante —
# vedi docs/OPEN_QUESTIONS.md Q14). Servono davvero per
# **SDL_VIDEODRIVER=kmsdrm** (DRM/KMS diretto via GBM+EGL, senza compositor
# Wayland/X11 in mezzo): con solo libgbm1+libegl-mesa0, kmsdrm falliva
# comunque con "SDL error: EGL not initialized" — mancava **libegl1**, il
# dispatch loader EGL generico che le app caricano (libegl-mesa0 è solo
# l'implementazione vendor Mesa, caricata poi via ICD — stessa separazione
# di libgl1/libgl1-mesa-dri; scoperto sul secondo test reale, 2026-08-10).
# Mesa fornisce EGL/GLES/GBM **software** (nessuna GPU reale richiesta,
# coerente con l'assenza di driver Mali/Rockchip in questa immagine
# "generica").
#
# libdrm2 esplicito (non lasciato solo alla dipendenza transitiva di
# libgbm1): src/drm_display.rs linka libdrm direttamente
# (rustc-link-lib=drm) per il backend "drm" — rendering diretto via API DRM
# legacy, che bypassa SDL2 del tutto. Aggiunto perché anche kmsdrm (sopra)
# si è rivelato inutilizzabile su questo hardware: il driver Rockchip
# mostra schermo nero sul percorso KMS *atomico* (usato sia da SDL2 sia dal
# driver `drm.c` vendorizzato in lvgl-sys), verificato con `modetest -a` —
# solo l'API *legacy* (`drmModeSetCrtc`) funziona su questo device, vedi
# `docs/OPEN_QUESTIONS.md` Q14 per l'indagine completa.

# python3: PyO3 gira con `auto-initialize`, quindi serve l'interprete completo
#   (stdlib inclusa), non la sola libpython.
# python3-pip + RestrictedPython: senza, il motore script parte NON sandboxato
#   con un warning all'avvio. L'immagine legacy aveva esattamente questo buco.
# libfreetype6 + fonts-dejavu-core: il viewer LVGL disegna il testo con
#   FreeType (Q24). I font Montserrat inclusi in LVGL coprono solo l'ASCII e
#   ciò che manca NON viene disegnato affatto — su un'interfaccia italiana
#   "più", "però", "perché" si vedono mutilate. Senza libfreetype il binario
#   non parte proprio (è una NEEDED); senza il file di font parte e ripiega su
#   Montserrat, dicendolo nel log.
# curl: usato dall'HEALTHCHECK qui sotto.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        libpython3.12t64 \
        python3-pip \
        $( [ "$WITH_LVGL" = "1" ] && echo libsdl2-2.0-0 libegl1 libegl-mesa0 libgles2 libgl1-mesa-dri libwayland-egl1 libgbm1 libdrm2 libfreetype6 fonts-dejavu-core ) && \
    pip install --no-cache-dir --break-system-packages "RestrictedPython>=7.0" && \
    apt-get purge -y python3-pip && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Copia l'intera bin/ (non solo sws-runtime per nome): con --with-lvgl,
# scripts/build_container_aarch64_generic.sh mette in bin/ anche
# sws-lvgl-viewer, che finisce così nella stessa immagine — stesso principio
# di Containerfile.aarch64, vedi lì per i dettagli. ENTRYPOINT resta
# sws-runtime di default.
COPY bin/             /usr/local/bin/
COPY templates/      /var/sws/templates/

# La SPA sta DENTRO l'immagine, come negli altri due percorsi container e per
# le stesse ragioni: col registry i layer si deduplicano, un frontend nuovo
# trasferisce il solo layer della SPA, e non c'è modo di ritrovarsi sul
# dispositivo una SPA di versione diversa dal binario.
#
# Sta DOPO il binario e non prima: è il layer che cambia più spesso, e un
# layer che cambia invalida tutti quelli sotto.
COPY www/            /var/sws/www/

# Punti di mount dei dati persistenti. Vanno montati come volumi podman:
# senza, config e progetti vivono nel layer scrivibile e spariscono col
# container. /var/sws/www NON è fra questi: è contenuto dell'immagine.
RUN mkdir -p /var/sws/config /var/sws/projects

# 8443 viewer operatori, 8444 IDE/admin.
EXPOSE 8443 8444

# http, non https: il runtime parte in HTTP finché non esiste config/tls.crt
# (sws-runtime/src/main.rs, avvio del listener).
# NB: HEALTHCHECK non esiste nella spec OCI — va costruito con
# `podman build --format docker`, altrimenti podman lo scarta con un warning.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fs http://localhost:8443/health || exit 1

# Nessun entrypoint script: niente SWS_ADMIN_PASSWORD obbligatorio (il
# no-auth mode è lo stato normale del PoC) e i flag stanno tutti nel CMD,
# così `podman run ... <altri flag>` li può sostituire.
LABEL org.opencontainers.image.source="https://github.com/soligolab/sws" \
      org.opencontainers.image.description="SWS runtime (aarch64, generico — non Pixsys-tuned) — viewer 8443, IDE/admin 8444, SPA inclusa. Montare i dati su /var/sws/{config,projects,logs}." \
      org.opencontainers.image.licenses="AGPL-3.0-only"

ENTRYPOINT ["/usr/local/bin/sws-runtime"]
# ── L'IDE sul dispositivo e' un caso particolare, non il default ────────────
#
# Decisione del maintainer (2026-09-02). `--no-admin` nel CMD qui sotto **non
# toglie il Deploy**: la porta 8444 resta e serve solo la gestione remota che
# l'editor chiama (deploy, pull, backup, utenti, datastore), tutto autenticato.
# Cade l'IDE: nessuna interfaccia servita, nessuna modifica del progetto sul
# dispositivo, nessun /api/script/exec, nessun /api/fs/*. Vedi `deploy_only_app`
# in sws-web/src/router.rs e OPEN_QUESTIONS Q8.
#
# Per riaccendere l'IDE completo su un dispositivo si sovrascrive il comando nel
# quadlet (`Exec=` in sws-runtime.container) togliendo quel flag: qui non c'e' un
# entrypoint script, e non ne vogliamo uno solo per una variabile d'ambiente.
CMD ["--config", "/var/sws/config", \
     "--projects-root", "/var/sws/projects", \
     "--templates-root", "/var/sws/templates", \
     "--www", "/var/sws/www", \
     "--viewer-port", "8443", \
     "--admin-port", "8444", \
     "--no-admin"]
