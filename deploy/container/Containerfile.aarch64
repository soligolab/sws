# SWS runtime — immagine container aarch64 per device Pixsys OS con podman.
#
# NON compila nulla: il binario arriva già cross-compilato da
# `scripts/yocto/build.sh` (SDK Pixsys), che è la catena di build preferita
# del progetto. Compilare Rust dentro un'immagine arm64 in emulazione QEMU
# richiederebbe ore; qui la build dura secondi.
#
# Il contesto di build è la directory staging preparata da
# `scripts/build_container.sh` (bin/, templates/, www/), non la radice del
# repo: tenerlo piccolo evita di impacchettare target/ e node_modules.
#
# Percorso separato e indipendente da `sws-runtime/docker/Dockerfile` (immagine
# legacy, disattivata in CI). Per x86_64 vedi Containerfile.x86_64 accanto a
# questo file + docs/DEPLOY_CONTAINER_X86_64.md — non docs/DEPLOY_PX30.md, che
# copre target ARM64 generici (Raspberry Pi, Jetson...) buildati da un laptop
# x86, non un target x86_64.

# ubuntu:24.04 non è una scelta estetica. Il binario cross-compilato dichiara:
#   NEEDED  libpython3.12.so.1.0
#   simboli fino a GLIBC_2.39
# quindi la base deve avere insieme Python 3.12 e glibc >= 2.39:
#   debian:bookworm-slim  glibc 2.36 + Python 3.11  → doppiamente incompatibile
#   debian:trixie-slim    glibc 2.41 + Python 3.13  → manca libpython3.12
#   ubuntu:24.04          glibc 2.39 + Python 3.12  → combacia
# Se un giorno l'SDK Pixsys passa a un'altra minor di Python, questa riga va
# cambiata di conseguenza (ricontrollare con `readelf -d` sul binario).
FROM ubuntu:24.04

# Passato da scripts/build_container.sh (--build-arg WITH_LVGL=1 quando
# --with-lvgl è attivo). Serve solo per decidere se installare libsdl2-2.0-0
# qui sotto: sws-lvgl-viewer linka SDL2 dinamicamente, e senza la libreria
# runtime nell'immagine finale parte e crasha subito ("cannot open shared
# object file" — riprodotto sul percorso container generico gemello,
# 2026-08-09, stessa causa qui perché stesso Containerfile "slim", nessuna
# libreria grafica installata di default). Non installata incondizionatamente:
# chi non passa --with-lvgl non deve appesantirsi per una dipendenza che non
# usa.
ARG WITH_LVGL=0

# libegl1/libegl-mesa0/libgles2/libgl1-mesa-dri/libwayland-egl1/libgbm1
# (sotto lo stesso WITH_LVGL): servono per SDL_VIDEODRIVER=kmsdrm (DRM/KMS
# diretto via GBM+EGL, senza compositor Wayland/X11). libegl1 è il dispatch
# loader EGL generico che le app caricano — libegl-mesa0 da solo è solo
# l'implementazione vendor Mesa, caricata poi via ICD (stessa separazione di
# libgl1/libgl1-mesa-dri): senza libegl1, kmsdrm fallisce con "SDL error:
# EGL not initialized" (scoperto sul percorso container generico gemello,
# 2026-08-10, in due passi — prima mancava libgbm1, poi anche libegl1). Mesa
# fornisce EGL/GLES/GBM software, nessuna GPU reale richiesta — non ancora
# verificato su questo percorso specifico (mai eseguito con successo, manca
# l'SDK Yocto).
#
# libdrm2 esplicito: src/drm_display.rs linka libdrm direttamente per il
# backend "drm" (rendering via API DRM legacy, bypassa SDL2 del tutto) —
# anche kmsdrm si è rivelato inutilizzabile su tc620-a-p3-c6-07aff9.local,
# il driver Rockchip mostra schermo nero sul percorso KMS *atomico* (usato
# sia da SDL2 sia dal driver drm.c vendorizzato in lvgl-sys), solo l'API
# legacy funziona — vedi docs/OPEN_QUESTIONS.md Q14.

# python3: PyO3 gira con `auto-initialize`, quindi serve l'interprete completo
#   (stdlib inclusa), non la sola libpython.
# python3-pip + RestrictedPython: senza, il motore script parte NON sandboxato
#   con un warning all'avvio. L'immagine legacy aveva esattamente questo buco.
# curl: usato dall'HEALTHCHECK qui sotto.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        libpython3.12t64 \
        python3-pip \
        $( [ "$WITH_LVGL" = "1" ] && echo libsdl2-2.0-0 libegl1 libegl-mesa0 libgles2 libgl1-mesa-dri libwayland-egl1 libgbm1 libdrm2 ) && \
    pip install --no-cache-dir --break-system-packages "RestrictedPython>=7.0" && \
    apt-get purge -y python3-pip && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Copia l'intera bin/ (non solo sws-runtime per nome): con --with-lvgl,
# scripts/build_container.sh mette in bin/ anche sws-lvgl-viewer, che finisce
# così nella stessa immagine senza bisogno di un COPY condizionale (non
# esprimibile in sintassi Containerfile/Dockerfile semplice). ENTRYPOINT resta
# sws-runtime di default — chi vuole anche il viewer LVGL lo invoca con
# `--entrypoint sws-lvgl-viewer` su un secondo container dalla stessa
# immagine, vedi docs/DEPLOY_CONTAINER_AARCH64.md per il comando completo.
COPY bin/             /usr/local/bin/
COPY templates/      /var/sws/templates/

# La SPA sta DENTRO l'immagine, dal 2026-07-30. Fino a quel giorno viaggiava a
# parte, in un archivio da srotolare in un bind mount, per non dover
# ritrasferire 59 MB a ogni modifica del frontend. Quella ragione è caduta col
# passaggio al registry: i layer si deduplicano, quindi un frontend nuovo
# trasferisce il solo layer della SPA (~0,4 MB) e non l'immagine intera. In
# cambio l'installazione è un `podman pull` e basta — nessun secondo artefatto
# da copiare, e nessun modo di ritrovarsi sul dispositivo una SPA di una
# versione diversa dal binario, che è già costata una caccia al fantasma.
#
# Sta DOPO il binario e non prima: è il layer che cambia più spesso, e un layer
# che cambia invalida tutti quelli sotto. Invertirli farebbe ritrasferire i
# 14 MB del binario a ogni ritocco del frontend.
COPY www/            /var/sws/www/

# Punti di mount dei dati persistenti. Vanno montati come volumi podman:
# senza, config e progetti vivono nel layer scrivibile e spariscono col
# container. /var/sws/www NON è fra questi: è contenuto dell'immagine.
RUN mkdir -p /var/sws/config /var/sws/projects

# 8443 viewer operatori, 8444 IDE/admin.
# Volutamente NON esposta la 9090: nel runtime non esiste alcun listener
# Prometheus, l'EXPOSE nell'immagine legacy è un residuo della spec.
EXPOSE 8443 8444

# http, non https: il runtime parte in HTTP finché non esiste config/tls.crt
# (sws-runtime/src/main.rs, avvio del listener). L'healthcheck legacy
# interrogava https e restava rosso per sempre.
# NB: HEALTHCHECK non esiste nella spec OCI — va costruito con
# `podman build --format docker`, altrimenti podman lo scarta con un warning.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fs http://localhost:8443/health || exit 1

# Nessun entrypoint script: niente SWS_ADMIN_PASSWORD obbligatorio (il
# no-auth mode è lo stato normale del PoC) e i flag stanno tutti nel CMD,
# così `podman run ... <altri flag>` li può sostituire.
# --viewer-port è indispensabile: senza, il viewer non va mai in ascolto e
# l'immagine servirebbe solo l'IDE (era il difetto del Dockerfile legacy).
# Metadati OCI. `image.source` non è decorativo: è il campo con cui GHCR collega
# il package al repository, quindi la pagina del package mostra README e licenza
# invece di essere un artefatto anonimo. `image.licenses` dichiara l'AGPL, che è
# la licenza del progetto e viaggia con un'immagine pubblica.
#
# In fondo e non dopo il FROM, ed è una differenza da 15 minuti: una LABEL in
# testa invalida la cache di tutto ciò che segue, quindi il layer apt (~60 MB,
# costruito sotto emulazione QEMU) verrebbe rifatto da zero a ogni ritocco dei
# metadati. Provato: 10 minuti solo per arrivare a configurare python3.12.
LABEL org.opencontainers.image.source="https://github.com/soligolab/sws" \
      org.opencontainers.image.description="SWS runtime (aarch64) — viewer 8443, IDE/admin 8444, SPA inclusa. Montare i dati su /var/sws/{config,projects,logs}." \
      org.opencontainers.image.licenses="AGPL-3.0-only"

ENTRYPOINT ["/usr/local/bin/sws-runtime"]
CMD ["--config", "/var/sws/config", \
     "--projects-root", "/var/sws/projects", \
     "--templates-root", "/var/sws/templates", \
     "--www", "/var/sws/www", \
     "--viewer-port", "8443", \
     "--admin-port", "8444"]
