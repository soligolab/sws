# Quadlet unit per OpenPLC Runtime in container podman (rootless).
#
# **Opzionale.** `install-container.sh` la mette solo con `--con-openplc`:
# «non è detto che a tutti i clienti serva» (decisione del maintainer,
# 23-10-2026). Un pannello che non la chiede non la vede nemmeno.
#
# Installato in ~/.config/containers/systemd/openplc-runtime.container,
# da cui systemd genera `openplc-runtime.service`.
#
# Comandi (come utente, senza sudo — vedi docs/HOWTO.md §27 se il bus non si
# trova):
#   XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user status openplc-runtime
#   XDG_RUNTIME_DIR=/run/user/$(id -u) journalctl --user -u openplc-runtime -f
#
# ── Governo ibrido (decisione del 23-10-2026) ────────────────────────────────
#
# Il quadlet è **nostro**: lo installiamo noi, e con il linger riparte dopo un
# riavvio come gli altri. L'**aggiornamento no**: `AutoUpdate=` non c'è, e non è
# una dimenticanza.
#
# Il ciclo di SWS — conferma, esito, ritorno alla versione precedente — è
# costruito sulle **nostre** immagini: sa leggerne le etichette dal registry, sa
# dire cosa cambia fra due versioni, sa tornare indietro. Su un'immagine di un
# altro registry non sa niente di tutto questo, e «tornare indietro» non è
# nemmeno definito. Finché non lo è, l'aggiornamento di OpenPLC resta di chi usa
# OpenPLC.
#
# È il modello che il VPS usa già per `portainer`: quadlet nostro, nessun
# `AutoUpdate`. `traefik` invece ce l'ha, ed è l'altra metà della stessa scelta.
#
# ── Le porte, e perché non sono quelle standard ──────────────────────────────
#
# OpenPLC vorrebbe Modbus sulla **502** e S7 sulla **102**. In podman
# **rootless** le porte sotto la 1024 non si pubblicano, e il sysctl che abbassa
# la soglia (`net.ipv4.ip_unprivileged_port_start`) sul pannello non c'è: esiste
# solo sul VPS, per Traefik. Abbassarlo su un pannello vorrebbe dire cambiare la
# postura di sicurezza del dispositivo per un companion opzionale.
#
# Quindi le porte sono alte, e **la sorgente Modbus di SWS le segue**: il campo
# `port` di una sorgente Modbus TCP è configurabile, e si punta a 127.0.0.1:1502.
#
# La 8443 invece è libera davvero: dal 21-10-2026 SWS è sulla 7443/7444, e
# l'API REST di OpenPLC può restare dov'è.

[Unit]
# La versione del quadlet: vedi il commento gemello in sws-runtime.container.
# Deve essere la stessa degli altri — `check_quadlet.sh` lo verifica.
Description=OpenPLC Runtime (container podman) [quadlet 6]
# Non ha bisogno del runtime di SWS: è un PLC, gira per conto suo. Ma se
# partono insieme conviene che il PLC ci sia prima, così la prima lettura di
# SWS non trova la porta chiusa.
Before=sws-runtime.service

[Container]
Image=ghcr.io/autonomy-logic/openplc-runtime:v4.3.1
ContainerName=openplc-runtime
# **Niente `AutoUpdate=`**: vedi il governo ibrido, in testa a questo file.

# I progetti e la configurazione di OpenPLC, sul disco del pannello: devono
# sopravvivere al container, che si ricrea a ogni riavvio dell'unità.
Volume=/data/user/openplc:/workdir

# L'API REST con cui si carica un programma. La 8443 è libera da quando SWS è
# passato alla 7443 (21-10-2026).
PublishPort=127.0.0.1:8443:8443
# Modbus TCP e S7, rimappati in alto: in rootless 502 e 102 non si pubblicano.
PublishPort=127.0.0.1:1502:502
PublishPort=127.0.0.1:10102:102
# Il server OPC UA. Se anche il progetto SWS accende il suo, uno dei due va
# spostato: sono tutti e due configurabili, e il piano dice di documentarlo.
PublishPort=127.0.0.1:14840:4840

# Solo loopback, in tutte e quattro: un PLC che ascolta sulla rete è una
# decisione di chi installa l'impianto, non un default. Chi lo vuole raggiungere
# da fuori toglie il `127.0.0.1:` sapendo cosa sta facendo.

# Il fuso dell'host, come negli altri quadlet (20-10-2026): senza, il container
# è in UTC e gli orari del PLC non combaciano con quelli dei sinottici.
Timezone=local

[Service]
# Come gli altri: riparte sempre, e con l'attesa che evita il ciclo stretto se
# l'immagine manca o il disco è pieno.
Restart=always
RestartSec=5

# **Niente `[Install] WantedBy=`**, come il viewer e per una ragione vicina: un
# PLC che parte da solo al boot su un pannello che nessuno ha configurato
# manderebbe uscite a un impianto senza che nessuno l'abbia chiesto. Lo avvia
# chi lo installa, con `systemctl --user enable --now openplc-runtime`, e
# l'installer lo dice.
