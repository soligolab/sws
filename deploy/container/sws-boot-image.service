# Installa l'immagine di boot che il progetto abilita (T-72 F5).
#
# Installato da `install-container.sh` in
#   ~/.config/systemd/user/sws-boot-image.service
#
# Parte in due occasioni: all'avvio della sessione utente (`WantedBy`), perché
# una richiesta arrivata mentre il dispositivo era spento non si perda; e a ogni
# modifica di `boot-image/trigger` (`sws-boot-image.path`).
#
# NON riavvia niente: il launcher Pixsys legge la configurazione al suo avvio,
# quindi l'immagine compare al prossimo avvio del pannello. Distinto da
# `sws-display.service` di proposito: quello finisce sempre riavviando browser o
# viewer, e usarlo qui farebbe sfarfallare lo schermo a ogni deploy.
#
# Comandi (come utente, senza sudo):
#   systemctl --user start sws-boot-image        applica adesso
#   journalctl --user -u sws-boot-image -n 20    cosa ha deciso, e perché
#   cat /data/user/sws/config/boot-image/status  com'è andata

[Unit]
Description=SWS — installa l'immagine di boot sul launcher Pixsys
After=sws-runtime.service

[Service]
Type=oneshot
ExecStart=/data/user/sws-container/sws-boot-image-apply.sh
# `oneshot` con `RemainAfterExit=no`: ha finito il suo lavoro, e la `.path` deve
# poterla rilanciare a ogni modifica.
RemainAfterExit=no

[Install]
WantedBy=default.target
