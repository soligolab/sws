[Unit]
Description=SWS runtime (HTTPS on :8443)
Documentation=https://github.com/soligolab/sws
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/data/user/sws/sws-runtime-launch.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# The runtime binds to 0.0.0.0:8443 — needs CAP_NET_BIND_SERVICE only if you
# ever drop it below 1024 (not the case today). Running as root keeps things
# simple for the PoC; lock down later when graduating to product.
User=root

[Install]
WantedBy=multi-user.target
