[Unit]
Description=SWS runtime (HTTPS on :7443)
Documentation=https://github.com/soligolab/sws
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/data/user/sws/sws-runtime-launch.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Not root (18-11-2026, decision D19 of the CRA sessions, as the maintainer
# asked: «sws deve essere senza root ovunque»). `user` is the panel's own
# account: the rootless container runs as it too, and PixsysOS lets it change
# network, time and reboot (polkit), use the serial ports and the screen. The
# installation hands it /data/user/sws.
User=user

[Install]
WantedBy=multi-user.target
