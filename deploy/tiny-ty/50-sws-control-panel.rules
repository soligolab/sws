// SWS control panel: what the runtime (user `sws`) may change on the system
// from the device's own screen. For polkit >= 0.106 (JavaScript rules); polkit
// 0.105 reads 50-sws-control-panel.pkla instead. Plan
// docs/plans/2026-11-13-pannello-di-controllo.md.
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.checkpoint-rollback",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.timedate1.set-time",
        "org.freedesktop.timedate1.set-timezone",
        "org.freedesktop.timedate1.set-ntp",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions"
    ];
    if (subject.user == "sws" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
