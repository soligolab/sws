[Unit]
# Il viewer LVGL sul Tiny TY: scrive direttamente sullo schermo (DRM) e legge il
# touch, senza compositore e senza browser. Piano
# docs/plans/2026-10-30-sws-lvgl-sul-tiny-ty.md, passo 3.
#
# Diversamente dai pannelli PixsysOS, qui il viewer **parte da sé** e resta
# acceso: sul Tiny TY non c'è un browser con cui alternarsi, quindi non serve
# che lo accenda il runtime (`display_target.rs`). Un deploy non lo riavvia:
# il viewer DRM ricarica la pagina quando il progetto cambia
# (`ricarica_se_chiesto`).
Description=SWS viewer LVGL (Tiny TY)
# Il runtime deve esserci, ma non `Requires=`: un viewer che aspetta il runtime
# è meglio di un viewer fermato insieme a lui.
After=sws-runtime.service
Wants=sws-runtime.service
# After rc.local, which decides whether the Pixsys setup opens (/tmp/runsetup):
# the launcher must find that decision already made. Harmless where there is
# no rc.local.
After=rc-local.service

[Service]
Type=simple
# As root (`+`): backlight and buzzer writable by the `video` group, also when
# rc.local exported the buzzer channel before the udev rule could see it.
ExecStartPre=+/opt/sws/bin/sws-hw-access.sh
ExecStart=/opt/sws/bin/sws-lvgl-viewer-launch.sh
# `always`: all'abbinamento il viewer esce per passare al progetto e trova 503
# finché il progetto non è attivo (visto il 12-11-2026); lo rilancia systemd.
Restart=always
RestartSec=5

# `video` per /dev/dri e per la retroilluminazione, `input` per il touch. I
# permessi su luce e cicalino li dà la regola udev 99-sws-tiny-ty.rules.
User=sws
Group=sws
SupplementaryGroups=video input

# Lo stesso posto che il viewer usa nei container (`SWS_VIEWER_DATA`): esito
# dell'aggiornamento, versione ignorata, sessione.
Environment=SWS_VIEWER_DATA=/var/lib/sws/viewer

# Il PLC vince anche qui (vedi sws-runtime.service). Il viewer si sacrifica
# per primo: ripartire costa un secondo e non perde dati. Misurato il
# 12-11-2026: ~18 MB di PSS a 1024×600.
CPUWeight=20
Nice=10
OOMScoreAdjust=600
MemoryHigh=40M
MemoryMax=64M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
