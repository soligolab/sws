# Il gateway SWS — una porta sola davanti a tutti i progetti.
#
#   systemctl --user start|stop|status sws-gateway
#   journalctl --user -u sws-gateway -f
#
# TRE COSE NON OVVIE, e tutte e tre sono gia' costate tempo a qualcuno.
#
# 1. IL SOCKET DI PODMAN. Il gateway avvia un container per ogni progetto
#    aperto, quindi gli serve il socket — e chi controlla quel socket controlla
#    la macchina (lo stesso motivo per cui a Traefik NON e' stato dato). Qui e'
#    inevitabile: e' il mestiere di questo processo. Dentro il container si e'
#    root, cioe' uid 0, quindi `/run/user/1000/...` non sarebbe il percorso che
#    il programma cerca: si monta altrove e si dichiara XDG_RUNTIME_DIR.
#
# 2. I PROGETTI STANNO ALLO STESSO PERCORSO DENTRO E FUORI. Il gateway
#    controlla che la cartella del progetto esista (e quel controllo avviene
#    qui dentro), poi passa lo stesso percorso a podman come sorgente del bind
#    mount del figlio — e podman lo risolve SULL'HOST. Con due percorsi diversi
#    il controllo passerebbe e il container del progetto partirebbe vuoto.
#    Montare la radice allo stesso posto toglie la differenza invece di
#    gestirla. Vedi il campo `radice` in gateway/progetti.rs.
#
# 3. NESSUNA PORTA PUBBLICATA, NE' QUI NE' NEI FIGLI. Traefik raggiunge questo
#    container per nome sulla rete sws-rete, e il gateway raggiunge i figli
#    allo stesso modo (--gateway-rete). Dall'esterno della macchina un progetto
#    non esiste: si passa di qui o non si passa.
[Unit]
Description=SWS — il gateway dei progetti
After=network-online.target

[Container]
# Inchiodata a una VERSIONE, non a un tag mobile: il gateway e i container dei
# progetti devono essere la stessa versione, e `AutoUpdate=registry` su un tag
# mobile li farebbe divergere a meta' aggiornamento. Si aggiorna a mano
# cambiando questa riga e --gateway-immagine insieme.
#
# Il tag della versione e non quello del commit (dal 14-10-2026): di una `-rc`
# si costruisce un'immagine sola, quindi i due dicono la stessa cosa — ma il
# numero di versione e' quello che il pannello e la console confrontano, e
# ritrovarlo qui evita di dover tradurre un sha per sapere cosa sta girando.
Image=ghcr.io/soligolab/sws-runtime:76aecffb-amd64

# ── Le etichette delle Novità non entrano nel container (22-10-2026) ─────────
#
# L'immagine porta 5 872 byte di etichette, e le tre grosse sono testo:
# `novita.it`, `novita.en` e `changelog` da sole fanno 4 717 byte. Podman
# scrive **tutte** le etichette del container dentro ogni evento che manda al
# journal, e il controllo di salute ne produce due ogni 30 secondi
# (`health_status` e `exec_died`). Misurato su una finestra vera: 29 664 byte
# di journal per ciclo con le etichette, 8 652 senza — il **71 % in meno**.
# Sul pannello del maintainer il journal era saturato dai messaggi di
# aggiornamento al punto da non poterci più leggere altro.
#
# Svuotarle qui non toglie niente a nessuno: il controllo degli aggiornamenti
# legge le etichette dal **registry**, dal config blob del manifest, non dal
# container che gira (`aggiornamento.rs`, fn `etichette`) — e in tutto il
# codice Rust non c'è una sola lettura di `podman inspect`.
#
# Si svuotano **per nome**, mai con un carattere jolly: `net.soligo.sws.progetto`
# è l'etichetta con cui il gateway ritrova i container dei suoi progetti, e
# quella va letta davvero (`gateway/podman.rs`).
#
# Provato il 22-10-2026 su podman 4.3.1: `--label chiave=` lascia la chiave e
# svuota il valore, e non tocca le etichette vicine.
Label=net.soligo.sws.novita.it=
Label=net.soligo.sws.novita.en=
Label=net.soligo.sws.compat.it=
Label=net.soligo.sws.compat.en=
Label=net.soligo.sws.changelog=
Label=net.soligo.sws.compat=
ContainerName=sws-gateway
Network=sws-rete.network

Volume=%h/sws-vps/gateway-config:/var/sws/config
Volume=%h/sws-vps/progetti:%h/sws-vps/progetti
Volume=%t/podman/podman.sock:/run/sws/podman/podman.sock
Environment=XDG_RUNTIME_DIR=/run/sws

# Niente --viewer-port: il gateway non fa girare nessun impianto, smista. E
# niente --no-admin: l'IDE e' proprio quello che serve.
Exec=--config /var/sws/config \
     --projects-root %h/sws-vps/progetti \
     --templates-root /var/sws/templates \
     --catalog-root /var/sws/catalogo/dispositivi \
     --www /var/sws/www \
     --admin-port 8444 \
     --gateway \
     --gateway-immagine ghcr.io/soligolab/sws-runtime:76aecffb-amd64 \
     --gateway-rete sws-rete

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
