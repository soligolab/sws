    { "nome": "i8",       "categoria": "intero", "bit": 8,  "min": "-128", "max": "127", "iniziale": 0 },
    { "nome": "i16",      "categoria": "intero", "bit": 16, "min": "-32768", "max": "32767", "iniziale": 0 },
