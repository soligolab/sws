{
  "_comment": "What the live parts of a symbol do with their input, and how the timed ones move: read by sws-core/src/symbol_behaviour.rs and sws-editor/tests/symbolBehaviour.test.ts. Plan docs/archive/2026-11-19-animazioni-dei-simboli.md. In `values`, `expected` lists only the parts to check; null = left out (a rotor or a level not bound follows the whole symbol).",
  "parts": [
    {
      "id": "needle",
      "kind": "needle",
      "cx": 30,
      "cy": 26,
      "a0": -135,
      "a1": 135
    },
    {
      "id": "lever",
      "kind": "lever",
      "cx": 30,
      "cy": 24,
      "open": 0,
      "closed": -90
    },
    {
      "id": "lamp",
      "kind": "lamp"
    },
    {
      "id": "fan",
      "kind": "rotor",
      "cx": 50,
      "cy": 50,
      "symmetry": 60
    },
    {
      "id": "fan2",
      "kind": "rotor",
      "cx": 20,
      "cy": 20,
      "symmetry": 90,
      "ccw": true
    },
    {
      "id": "tank",
      "kind": "level",
      "x": 10,
      "y": 10,
      "w": 20,
      "h": 80
    },
    {
      "id": "tank2",
      "kind": "level",
      "x": 40,
      "y": 10,
      "w": 20,
      "h": 80,
      "dir": "right"
    },
    {
      "id": "gate",
      "kind": "slide",
      "dx": 0,
      "dy": -40
    },
    {
      "id": "motor",
      "kind": "vibrate",
      "amplitude": 2,
      "axis": "y"
    },
    {
      "id": "glow",
      "kind": "pulse",
      "depth": 0.5,
      "period_ms": 1200
    },
    {
      "id": "beacon",
      "kind": "signal",
      "color": "#64748b",
      "entries": [
        {
          "value": 1,
          "color": "#22c55e"
        },
        {
          "value_min": 2,
          "value_max": 9,
          "color": "#ef4444",
          "blink": true
        },
        {
          "value": 0,
          "hidden": true
        }
      ]
    }
  ],
  "values": [
    {
      "name": "nothing bound: as drawn; rotor and level follow the symbol",
      "bindings": {},
      "tags": {},
      "expected": {
        "needle": {
          "frazione": null
        },
        "lever": {
          "aperta": null
        },
        "lamp": {
          "accesa": null
        },
        "fan": null,
        "fan2": null,
        "tank": null,
        "tank2": null,
        "gate": {
          "frazione": null
        },
        "motor": {
          "active": null
        },
        "glow": {
          "active": null
        },
        "beacon": {
          "entry": null
        }
      }
    },
    {
      "name": "a rotor bound to a true tag turns; the other follows the symbol",
      "bindings": {
        "fan": {
          "tag": "run"
        }
      },
      "tags": {
        "run": true
      },
      "expected": {
        "fan": {
          "active": true
        },
        "fan2": null
      }
    },
    {
      "name": "a rotor bound to a tag with no value yet: as drawn",
      "bindings": {
        "fan": {
          "tag": "missing"
        }
      },
      "tags": {},
      "expected": {
        "fan": {
          "active": null
        }
      }
    },
    {
      "name": "fixed values",
      "bindings": {
        "fan": {
          "value": true
        },
        "motor": {
          "value": 1
        },
        "glow": {
          "value": false
        }
      },
      "tags": {},
      "expected": {
        "fan": {
          "active": true
        },
        "motor": {
          "active": true
        },
        "glow": {
          "active": false
        }
      }
    },
    {
      "name": "the tag wins over the fixed value",
      "bindings": {
        "motor": {
          "tag": "m",
          "value": true
        }
      },
      "tags": {
        "m": false
      },
      "expected": {
        "motor": {
          "active": false
        }
      }
    },
    {
      "name": "an empty tag is no tag: the fixed value",
      "bindings": {
        "motor": {
          "tag": "",
          "value": true
        }
      },
      "tags": {},
      "expected": {
        "motor": {
          "active": true
        }
      }
    },
    {
      "name": "a slide on a true tag goes to the end",
      "bindings": {
        "gate": {
          "tag": "open"
        }
      },
      "tags": {
        "open": true
      },
      "expected": {
        "gate": {
          "frazione": 1
        }
      }
    },
    {
      "name": "a slide on a false tag stays at the start",
      "bindings": {
        "gate": {
          "tag": "open"
        }
      },
      "tags": {
        "open": false
      },
      "expected": {
        "gate": {
          "frazione": 0
        }
      }
    },
    {
      "name": "a slide at 40 of 0..100",
      "bindings": {
        "gate": {
          "tag": "pos",
          "min": 0,
          "max": 100
        }
      },
      "tags": {
        "pos": 40
      },
      "expected": {
        "gate": {
          "frazione": 0.4
        }
      }
    },
    {
      "name": "a level bound per part, 0..100 by default; the other follows the symbol",
      "bindings": {
        "tank": {
          "tag": "lvl"
        }
      },
      "tags": {
        "lvl": 25
      },
      "expected": {
        "tank": {
          "frazione": 0.25
        },
        "tank2": null
      }
    },
    {
      "name": "a level with its own scale and a fixed value",
      "bindings": {
        "tank2": {
          "value": 7.5,
          "min": 0,
          "max": 10
        }
      },
      "tags": {},
      "expected": {
        "tank2": {
          "frazione": 0.75
        }
      }
    },
    {
      "name": "a signal in a range",
      "bindings": {
        "beacon": {
          "tag": "s"
        }
      },
      "tags": {
        "s": 5
      },
      "expected": {
        "beacon": {
          "entry": 1
        }
      }
    },
    {
      "name": "a signal with no entry that matches: as drawn",
      "bindings": {
        "beacon": {
          "tag": "s"
        }
      },
      "tags": {
        "s": 42
      },
      "expected": {
        "beacon": {
          "entry": null
        }
      }
    },
    {
      "name": "a signal on a fixed text that equals a number",
      "bindings": {
        "beacon": {
          "value": "1"
        }
      },
      "tags": {},
      "expected": {
        "beacon": {
          "entry": 0
        }
      }
    },
    {
      "name": "a signal on zero: the hidden entry",
      "bindings": {
        "beacon": {
          "tag": "s"
        }
      },
      "tags": {
        "s": 0
      },
      "expected": {
        "beacon": {
          "entry": 2
        }
      }
    },
    {
      "name": "the old kinds with a fixed value",
      "bindings": {
        "needle": {
          "value": 50
        },
        "lamp": {
          "value": true
        }
      },
      "tags": {},
      "expected": {
        "needle": {
          "frazione": 0.5
        },
        "lamp": {
          "accesa": true
        }
      }
    }
